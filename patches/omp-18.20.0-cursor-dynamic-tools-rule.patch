+/**
+ * Cursor keeps MCP tools out of the model's function list; the model reaches
+ * them only through GetDynamicTools and CallDynamicTool. Without this rule it
+ * reports advertised tools as unavailable.
+ */
+export function cursorDynamicToolsRule(toolNames: readonly string[]): string | undefined {
+	if (toolNames.length === 0) return undefined;
+	return (
+		`Cursor lists these tools only as dynamic tools, not in your function list: ${toolNames.join(", ")}. ` +
+		"Call GetDynamicTools to see their schemas and CallDynamicTool to run one. " +
+		"Never conclude one of them is missing before you look it up."
+	);
+}
