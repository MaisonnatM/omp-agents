@@ -0,0 +1,149 @@
+/**
+ * With `OMP_MCP_LAZY=1`, a stdio server runs only while something uses it: a server
+ * seen before registers its tools from the cached manifest with no process, its first
+ * call starts it, and it stops again once idle. A server never seen before is
+ * discovered once (connect, list, cache, stop).
+ */
+import { afterEach, beforeEach, describe, expect, it } from "bun:test";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import type { CustomToolContext } from "@oh-my-pi/pi-coding-agent/extensibility/custom-tools/types";
+import { MCPManager } from "@oh-my-pi/pi-coding-agent/mcp/manager";
+import { MCPToolCache } from "@oh-my-pi/pi-coding-agent/mcp/tool-cache";
+import type { MCPStdioServerConfig } from "@oh-my-pi/pi-coding-agent/mcp/types";
+import type { AgentStorageApi } from "@oh-my-pi/pi-coding-agent/session/agent-storage";
+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { removeSyncWithRetries } from "@oh-my-pi/pi-utils";
+import { SERVER_INSTRUCTIONS, TOOL_RESULT } from "./fixtures/instructions-mcp";
+
+const SERVER = "lazy";
+const config: MCPStdioServerConfig = {
+	type: "stdio",
+	command: process.execPath,
+	args: [path.join(import.meta.dir, "fixtures", "instructions-mcp.ts")],
+};
+
+function memoryCache(): MCPToolCache {
+	const entries = new Map<string, string>();
+	const storage = {
+		getCache: (key: string) => entries.get(key) ?? null,
+		setCache: (key: string, value: string) => void entries.set(key, value),
+	} as unknown as AgentStorageApi;
+	return new MCPToolCache(storage);
+}
+
+async function waitFor(predicate: () => boolean): Promise<boolean> {
+	const deadline = Date.now() + 10_000;
+	while (!predicate()) {
+		if (Date.now() >= deadline) return false;
+		await Bun.sleep(10);
+	}
+	return true;
+}
+
+describe("lazy stdio MCP servers", () => {
+	const saved = { lazy: Bun.env.OMP_MCP_LAZY, idle: Bun.env.OMP_MCP_LAZY_IDLE_MS };
+	let workDir: string;
+	let auth: AuthStorage;
+	let context: CustomToolContext;
+	const managers: MCPManager[] = [];
+
+	beforeEach(async () => {
+		Bun.env.OMP_MCP_LAZY = "1";
+		Bun.env.OMP_MCP_LAZY_IDLE_MS = "200";
+		workDir = fs.mkdtempSync(path.join(os.tmpdir(), "omp-mcp-lazy-"));
+		auth = await AuthStorage.create(":memory:");
+		context = {
+			sessionManager: SessionManager.inMemory(),
+			modelRegistry: new ModelRegistry(auth),
+			model: undefined,
+			isIdle: () => true,
+			hasQueuedMessages: () => false,
+			abort: () => {},
+		};
+	});
+
+	afterEach(async () => {
+		for (const manager of managers) await manager.disconnectAll();
+		managers.length = 0;
+		auth.close();
+		removeSyncWithRetries(workDir);
+		for (const [key, value] of [
+			["OMP_MCP_LAZY", saved.lazy],
+			["OMP_MCP_LAZY_IDLE_MS", saved.idle],
+		] as const) {
