+/** Each choice option's label in an `ask` question, made unique by its value when two read the same. */
+function formOptionLabels(field: ChoiceField): string[] {
+	const labels = field.options.map(option => spansText(option.label).replace(/\s+/g, " ").trim() || option.value);
+	return labels.map((label, index) =>
+		labels.indexOf(label) === index ? label : `${label} (${field.options[index]!.value})`,
+	);
+}
+
+/** One `ask` question for a named form field: a choice field's enabled options, or none for a text field, answered by typing. */
+function formFieldQuestion(field: FormField, question: string, error: string | undefined): ExtensionAskDialogQuestion {
+	const prefill = field.kind === "text" && field.value !== "" ? ` (default: ${field.value})` : "";
+	const text = `${question}${prefill}${error ? ` (${error})` : ""}`;
+	if (field.kind === "text") return { id: field.name, question: text, options: [] };
+	const labels = formOptionLabels(field);
+	const enabled = field.options.flatMap((option, index) => (option.disabled ? [] : [index]));
+	const checked = enabled.findIndex(index => field.options[index]!.checked);
+	return {
+		id: field.name,
+		question: text,
+		options: enabled.map(index => ({ label: labels[index]! })),
+		multi: field.multi,
+		...(checked >= 0 ? { recommended: checked } : {}),
+	};
+}
+
+/**
+ * A field's value from its `ask` answer, or an error to ask it again with. A blank typed answer keeps a
+ * text field's prefilled value; typed text answers a choice field only through its "Other" answer.
+ */
+function formFieldAnswer(
+	field: FormField,
+	answer: ExtensionAskDialogResultItem,
+): { value: HtmlFormValue | undefined; error?: string } {
+	if (field.kind === "text") {
+		const value = textValue(field, answer.customInput ?? field.value);
+		return { value, error: fieldError(field, value) };
+	}
+	const labels = formOptionLabels(field);
+	const checked = new Set(answer.selectedOptions.map(label => labels.indexOf(label)));
+	if (answer.customInput !== undefined && !field.other) {
+		return { value: undefined, error: "Pick one of the options" };
+	}
+	const value = choiceValue(field, checked, answer.customInput);
+	return { value, error: fieldError(field, value) };
+}
+
+/**
+ * Sends an HTML form as one RPC `ask` dialog, a question per named field, so a host that opted into
+ * `set_ask_dialog` answers the whole form at once. Fields whose answers fail the form's checks are asked
+ * again with the reason; a timeout submits the values gathered so far over the form's defaults.
+ */
+export async function requestRpcFormDialog(
+	pendingRequests: Map<string, PendingExtensionRequest>,
+	output: RpcOutput,
+	html: string,
+	dialogOptions?: ExtensionUIDialogOptions,
+): Promise<ExtensionFormDialogResult | undefined> {
+	const form = parseHtmlForm(html);
+	const questions = fieldQuestions(form);
+	const data = defaultFormData(form);
+	let asking = form.fields
+		.filter(field => field.name)
+		.map(field => ({ field, error: undefined as string | undefined }));
+	while (asking.length > 0) {
+		const askQuestions = asking.map(({ field, error }) =>
+			formFieldQuestion(field, questions.get(field) ?? field.name, error),
+		);
+		let timedOut = false;
+		const opts: ExtensionUIDialogOptions = {
+			...dialogOptions,
+			onTimeout: () => {
+				timedOut = true;
+				dialogOptions?.onTimeout?.();
+			},
+		};
+		const result = await requestRpcDialog(
+			pendingRequests,
+			output,
+			opts,
+			undefined,
+			{ method: "ask", questions: askQuestions, timeout: dialogOptions?.timeout },
+			response => parseAskDialogResponse(response, askQuestions, opts),
+		);
+		if (timedOut) return { data, timedOut: true };
+		if (!result) return undefined;
+		const retry: typeof asking = [];
+		result.results.forEach((answer, index) => {
+			const field = asking[index]!.field;
+			const { value, error } = formFieldAnswer(field, answer);
+			if (value === undefined) delete data[field.name];
+			else data[field.name] = value;
+			if (error) retry.push({ field, error });
+		});
+		asking = retry;
+	}
+	return { data };
+}
