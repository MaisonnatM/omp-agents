+	// Anthropic reports a spent prepaid API balance as a 400 invalid_request_error.
+	const ANTHROPIC_CREDIT_BALANCE_ERROR =
+		'400 {"type":"error","error":{"type":"invalid_request_error","message":"Your credit balance is too low to access the Anthropic API. Please go to Plans & Billing to upgrade or purchase credits."},"request_id":"req_011"}';
+
+	it("walks the fallback chain on an Anthropic credit-balance 400 under retry.fallbackOn usage-limit", async () => {
+		const primaryModel = getBundledModel("anthropic", "claude-sonnet-4-5");
+		const fallbackModel = getBundledModel("openai", "gpt-4o-mini");
+		if (!primaryModel || !fallbackModel) {
+			throw new Error("Expected bundled test models to exist");
+		}
+		const primarySelector = `${primaryModel.provider}/${primaryModel.id}`;
+		const fallbackSelector = `${fallbackModel.provider}/${fallbackModel.id}`;
+
+		const requestedModels: string[] = [];
+		const agent = createFallbackAgent(primaryModel, requestedModels, { firstError: ANTHROPIC_CREDIT_BALANCE_ERROR });
+		const markReached = vi
+			.spyOn(modelRegistry.authStorage.limits, "markReached")
+			.mockResolvedValue({ switched: false });
+		const settings = Settings.isolated({
+			"compaction.enabled": false,
+			"retry.baseDelayMs": 1,
+			"retry.modelFallback": true,
+			"retry.fallbackOn": "usage-limit",
+			"retry.fallbackChains": { [primarySelector]: [fallbackSelector] },
+		});
+		session = new AgentSession({ agent, sessionManager: SessionManager.inMemory(), settings, modelRegistry });
+
+		await session.prompt("Spend the last of the API credits");
+		await session.waitForIdle();
+
+		expect(requestedModels).toEqual([primarySelector, fallbackSelector]);
+		expect(session.model?.provider).toBe(fallbackModel.provider);
+		expect(session.model?.id).toBe(fallbackModel.id);
+		// The spent key is marked used up, so usage-aware routing skips it.
+		expect(markReached).toHaveBeenCalledWith(
+			primaryModel.provider,
+			expect.anything(),
+			expect.objectContaining({ retryAfterMs: 30 * 60 * 1000, modelId: primaryModel.id }),
+		);
+	});
+
+	it("does not restore a credit-exhausted primary when the generic five-minute cooldown expires", async () => {
+		const primaryModel = getBundledModel("anthropic", "claude-sonnet-4-5");
+		const fallbackModel = getBundledModel("openai", "gpt-4o-mini");
+		if (!primaryModel || !fallbackModel) {
+			throw new Error("Expected bundled test models to exist");
+		}
+		const primarySelector = `${primaryModel.provider}/${primaryModel.id}`;
+		const fallbackSelector = `${fallbackModel.provider}/${fallbackModel.id}`;
+
+		const requestedModels: string[] = [];
+		const agent = createFallbackAgent(primaryModel, requestedModels, { firstError: ANTHROPIC_CREDIT_BALANCE_ERROR });
+		vi.spyOn(modelRegistry.authStorage.limits, "markReached").mockResolvedValue({ switched: false });
+		const settings = Settings.isolated({
+			"compaction.enabled": false,
+			"retry.baseDelayMs": 1,
+			"retry.modelFallback": true,
+			"retry.fallbackOn": "any",
+			"retry.fallbackRevertPolicy": "cooldown-expiry",
+			"retry.fallbackChains": { default: [fallbackSelector] },
+		});
+		settings.setModelRole("default", primarySelector);
+		session = new AgentSession({ agent, sessionManager: SessionManager.inMemory(), settings, modelRegistry });
+		let now = Date.now();
+		vi.spyOn(Date, "now").mockImplementation(() => now);
+
+		await session.prompt("Spend the last of the API credits");
+		await session.waitForIdle();
+		expect(requestedModels).toEqual([primarySelector, fallbackSelector]);
+
+		// Past the five-minute cooldown an unclassified error gets, well inside
+		// the billing cap's: the empty balance has not been topped up.
+		now += 6 * 60 * 1000;
+		await session.prompt("Keep working after the cooldown");
+		await session.waitForIdle();
+
+		expect(requestedModels).toEqual([primarySelector, fallbackSelector, fallbackSelector]);
+		expect(session.model?.id).toBe(fallbackModel.id);
+	});
+
