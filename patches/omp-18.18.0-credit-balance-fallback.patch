@@ -0,0 +1,470 @@
+import { describe, expect, test, vi } from "bun:test";
+import { Database } from "bun:sqlite";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { Effort } from "@oh-my-pi/pi-ai";
+import { AuthStorage, SqliteAuthCredentialStore } from "@oh-my-pi/pi-ai/auth-storage";
+import type { UsageProvider } from "@oh-my-pi/pi-ai/usage";
+import { claudeRankingStrategy } from "@oh-my-pi/pi-ai/usage/claude";
+import { cursorRankingStrategy, parseCursorIndividualUsage } from "@oh-my-pi/pi-ai/usage/cursor";
+import { AUTO_THINKING } from "@oh-my-pi/pi-tui/thinking";
+import * as autoThinkingClassifier from "../src/auto-thinking/classifier";
+import { ModelRegistry, type ProviderConfigInput } from "../src/config/model-registry";
+import { Settings } from "../src/config/settings";
+import { createAgentSession, type CreateAgentSessionOptions } from "../src/sdk";
+import type { AgentSession } from "../src/session/agent-session";
+import { SessionManager } from "../src/session/session-manager";
+
+async function createRoutingFixture(
+	fableFraction: number | null = 0.46,
+	disabledProviders: string[] = [],
+	usageReservePolicy: "auto" | "confirm" | "fail-closed" = "auto",
+) {
+	const root = await fs.mkdtemp(path.join(os.tmpdir(), "omp-paid-routing-"));
+	const quota = { opus: 1, fable: fableFraction, paidEnabled: true, failNext: false, reportsExhaustion: true };
+	const requests: { model: string; authorization: string | null }[] = [];
+	const resetsAt = Date.now() + 86_400_000;
+	const anthropicUsage: UsageProvider = {
+		id: "anthropic",
+		fetchUsage: async () => ({
+			provider: "anthropic",
+			fetchedAt: Date.now(),
+			limits: Object.entries({ opus: quota.opus, fable: quota.fable }).flatMap(([tier, fraction]) =>
+				fraction === null
+					? []
+					: [
+							{
+								id: `anthropic:7d:${tier}`,
+								label: tier,
+								scope: { provider: "anthropic", tier },
+								window: { id: "7d", label: "Weekly", durationMs: 604_800_000, resetsAt },
+								amount: { unit: "percent" as const, usedFraction: fraction },
+								status: quota.reportsExhaustion && fraction >= 1 ? ("exhausted" as const) : ("ok" as const),
+							},
+						],
+			),
+		}),
+	};
+	const cursorUsage: UsageProvider = {
+		id: "cursor",
+		fetchUsage: async () =>
+			parseCursorIndividualUsage({
+				individualUsage: {
+					plan: { enabled: true, limit: 7000, apiPercentUsed: 100, autoPercentUsed: 100 },
+					onDemand: { enabled: quota.paidEnabled, used: 13397, limit: null, remaining: null },
+				},
+			}),
+	};
+	const store = new SqliteAuthCredentialStore(new Database(":memory:"));
+	const auth = new AuthStorage(store, {
+		usageProviderResolver: provider =>
+			provider === "anthropic" ? anthropicUsage : provider === "cursor" ? cursorUsage : undefined,
+		rankingStrategyResolver: provider =>
+			provider === "anthropic" ? claudeRankingStrategy : provider === "cursor" ? cursorRankingStrategy : undefined,
+	});
+	for (const provider of ["anthropic", "cursor"]) {
+		await auth.credentials.set(provider, {
+			type: "oauth",
+			access: `fixture-${provider}`,
+			refresh: "fixture-refresh",
+			expires: Date.now() + 3_600_000,
+			accountId: `${provider}-account`,
+		});
+	}
+	const server = Bun.serve({
+		port: 0,
+		hostname: "127.0.0.1",
+		async fetch(request) {
+			if (request.method !== "POST") return new Response(null, { status: 204 });
