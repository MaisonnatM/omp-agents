diff --git a/packages/coding-agent/src/session/usage-aware-routing.ts b/packages/coding-agent/src/session/usage-aware-routing.ts
new file mode 100644
index 0000000000..f28f06915f
--- /dev/null
+++ b/packages/coding-agent/src/session/usage-aware-routing.ts
@@ -0,0 +1,227 @@
+import type { Model, ModelUsageHealth, RequestBillingIntent } from "@oh-my-pi/pi-ai";
+import { buildModelProviderPriorityRank } from "@oh-my-pi/pi-catalog/identity";
+import { modelKind } from "@oh-my-pi/pi-catalog/types";
+import type { ModelRegistry } from "../config/model-registry";
+import {
+	disabledProviderIds,
+	getModelMatchPreferences,
+	resolveConfiguredModelPatterns,
+	resolveModelOverride,
+} from "../config/model-resolver";
+import { isKindRole } from "../config/model-roles";
+import type { Settings } from "../config/settings";
+import {
+	findRetryFallbackCandidates,
+	formatRetryFallbackSelector,
+	getRetryFallbackChains,
+	parseRetryFallbackChainEntry,
+	parseRetryFallbackSelector,
+	type RetryFallbackSelector,
+} from "./retry-fallback-chains";
+import { cfgRetryUsageReservePolicy } from "./settings";
+
+export interface UsageRoutingCandidate {
+	selector: RetryFallbackSelector;
+	model: Model;
+	chainKey: string;
+}
+
+export type UsageRoutingDecision =
+	| { kind: "included"; candidate: UsageRoutingCandidate; apiKey: string; health: ModelUsageHealth }
+	| { kind: "paid-last-resort"; candidate: UsageRoutingCandidate; apiKey: string }
+	| { kind: "unavailable"; reason: string };
+
+/** Only configured chat routes enter the inventory, never the unconfigured catalog. */
+export function collectConfiguredUsageCandidates(
+	settings: Settings,
+	registry: ModelRegistry,
+	current?: UsageRoutingCandidate,
+): UsageRoutingCandidate[] {
+	const candidates: UsageRoutingCandidate[] = [];
+	const chains = getRetryFallbackChains(settings);
+	const context = { chains, getModelRole: (role: string) => settings.getModelRole(role), modelLookup: registry };
+	const append = (value: string, chainKey: string, primary?: RetryFallbackSelector) => {
+		for (const pattern of resolveConfiguredModelPatterns(value, settings)) {
+			const entry = parseRetryFallbackChainEntry(context, pattern, primary);
+			const resolved = resolveModelOverride([entry?.raw ?? pattern], registry, settings);
+			if (!resolved.model || modelKind(resolved.model) !== "chat") continue;
+			const selector = parseRetryFallbackSelector(
+				formatRetryFallbackSelector(resolved.model, entry?.thinkingLevel),
+				registry,
+			);
+			if (selector) candidates.push({ selector, model: resolved.model, chainKey });
+		}
+	};
+	for (const [role, value] of Object.entries(settings.getModelRoles())) {
+		if (!value || isKindRole(role)) continue;
+		const start = candidates.length;
+		append(value, role);
+		for (const primary of candidates.slice(start)) {
+			for (const selector of findRetryFallbackCandidates(context, role, primary.selector.raw, primary.model))
+				append(selector.raw, role, primary.selector);
+		}
+	}
+	for (const [key, chain] of Object.entries(chains)) {
+		if (isKindRole(key)) continue;
+		const primary = parseRetryFallbackSelector(key, registry) ?? current?.selector;
+		for (const value of chain) append(value, key, primary);
+	}
+	const priority = buildModelProviderPriorityRank(getModelMatchPreferences(settings).providerOrder);
+	return candidates.sort(
+		(a, b) =>
+			(priority.get(a.model.provider.toLowerCase()) ?? Infinity) -
+			(priority.get(b.model.provider.toLowerCase()) ?? Infinity),
+	);
+}
+
+/** All session entry points use the same included-plan terminal gate. */
+export async function resolveUsageRouting(options: {
+	preferred: readonly UsageRoutingCandidate[];
+	configured: readonly UsageRoutingCandidate[];
+	paidSelector: string;
+	registry: ModelRegistry;
+	settings: Settings;
+	sessionId?: string;
+	reserveFraction: number;
+	reserveConfirmation?:
+		| "defer"
+		| ((
+				primary: UsageRoutingCandidate,
+				fallback: UsageRoutingCandidate,
+				health: ModelUsageHealth,
+		  ) => Promise<boolean>);
+	eligible(candidate: UsageRoutingCandidate, billingIntent: RequestBillingIntent): boolean;
+	canSelect?(candidate: UsageRoutingCandidate, billingIntent: RequestBillingIntent): boolean;
+	signal?: AbortSignal;
+}): Promise<UsageRoutingDecision> {
+	const { registry, settings, signal } = options;
+	const disabled = disabledProviderIds(settings);
+	const seen = new Set<string>();
+	let reserve: { candidate: UsageRoutingCandidate; apiKey: string; health: ModelUsageHealth } | undefined;
+	let hasUnspentUnselectablePlan = false;
+	const preferred = new Set(options.preferred.map(candidate => candidate.selector.raw));
+	for (const candidate of [...options.preferred, ...options.configured]) {
+		signal?.throwIfAborted();
+		const { model, selector } = candidate;
+		if (seen.has(selector.raw)) continue;
+		seen.add(selector.raw);
+		if (disabled.has(model.provider) || !registry.hasConfiguredAuth(model) || !options.eligible(candidate, "default"))
+			continue;
+		let health: ModelUsageHealth;
+		try {
+			health = await registry.authStorage.health.model(model.provider, {
+				modelId: model.id,
+				baseUrl: model.baseUrl,
+				sessionId: options.sessionId,
+				accountIds: model.accountAccess && Object.keys(model.accountAccess),
+				reserveFraction: options.reserveFraction,
+				signal,
+			});
+		} catch (error) {
+			if (signal?.aborted) throw error;
+			health = { state: "unknown", accounts: [] };
+		}
+		if (
+			candidate === options.preferred[0] &&
+			cfgRetryUsageReservePolicy.get(settings) === "fail-closed" &&
+			(health.state === "depleted" || health.state === "reserve")
+		) {
+			return {
+				kind: "unavailable",
+				reason: `Usage ${health.state} for ${selector.raw}; reserve policy is fail-closed.`,
+			};
+		}
+		if (health.state === "depleted") continue;
+		if (model.accountAccess && health.accounts.length === 0) continue;
+		// Unmanaged metered keys are not additional included-plan funding.
+		if (
+			!preferred.has(selector.raw) &&
+			health.accounts.length === 0 &&
+			registry.authStorage.keys.source(model.provider)?.kind !== "oauth"
+		)
+			continue;
+		const selected = health.accounts.find(account => account.selected);
+		if (
+			options.sessionId &&
+			selected &&
+			selected.state !== "healthy" &&
+			health.accounts.some(account => account.state === "healthy")
+		) {
+			registry.authStorage.sessions.release(model.provider, options.sessionId);
+		}
+		let apiKey: string | undefined;
+		try {
+			apiKey = await registry.getApiKey(model, options.sessionId, { signal });
+		} catch (error) {
+			if (signal?.aborted) throw error;
+			continue;
+		}
+		if (!apiKey) continue;
+		if (options.canSelect?.(candidate, "default") === false) {
+			hasUnspentUnselectablePlan = true;
+			continue;
+		}
+		if (health.state === "reserve") {
+			reserve ??= { candidate, apiKey, health };
+			if (
+				candidate === options.preferred[0] &&
+				cfgRetryUsageReservePolicy.get(settings) === "confirm" &&
+				options.reserveConfirmation === "defer"
+			) {
+				return { kind: "included", candidate, apiKey, health };
+			}
+			continue;
+		}
+		if (
+			reserve &&
+			reserve.candidate === options.preferred[0] &&
+			cfgRetryUsageReservePolicy.get(settings) === "confirm" &&
+			typeof options.reserveConfirmation === "function" &&
+			!(await options.reserveConfirmation(reserve.candidate, candidate, reserve.health))
+		) {
+			return { kind: "included", candidate: reserve.candidate, apiKey: reserve.apiKey, health: reserve.health };
+		}
+		return { kind: "included", candidate, apiKey, health };
+	}
+	if (reserve)
+		return { kind: "included", candidate: reserve.candidate, apiKey: reserve.apiKey, health: reserve.health };
+	if (hasUnspentUnselectablePlan) {
+		return {
+			kind: "unavailable",
+			reason:
+				"A configured included-plan route still has unknown or unspent quota but cannot be retried for this request.",
+		};
+	}
+	if (!options.paidSelector.trim())
+		return {
+			kind: "unavailable",
+			reason: "No eligible configured included-plan route is available and paid fallback is disabled.",
+		};
+	const resolved = resolveModelOverride([options.paidSelector], registry, settings);
+	const model = resolved.model;
+	if (model && !disabled.has(model.provider)) {
+		const selector = parseRetryFallbackSelector(formatRetryFallbackSelector(model, resolved.thinkingLevel), registry);
+		if (selector) {
+			const candidate = { model, selector, chainKey: "paid-last-resort" };
+			if (
+				options.eligible(candidate, "paid-last-resort") &&
+				options.canSelect?.(candidate, "paid-last-resort") !== false
+			) {
+				try {
+					const apiKey = await registry.getApiKey(model, options.sessionId, {
+						signal,
+						billingIntent: "paid-last-resort",
+					});
+					if (apiKey) return { kind: "paid-last-resort", candidate, apiKey };
+				} catch (error) {
+					if (signal?.aborted) throw error;
+				}
+			}
+		}
+	}
+	return {
+		kind: "unavailable",
+		reason:
+			"All eligible configured included-plan routes are depleted or unavailable, and no usable paid fallback is available.",
+	};
+}
