 /** `{name, summary, dynamic}` triples for prompt templates and `/tools` display. */
-export function xdevEntries(state: XdevState): Array<{ name: string; summary: string; dynamic: boolean }> {
+export function xdevEntries(
+	state: XdevState,
+): Array<{ name: string; summary: string; dynamic: boolean; server?: string }> {
 	return listXdevTools(state).map(tool => {
 		// Built-ins are first-party; anything else carries third-party metadata. One
 		// boolean drives both the description cap and the flag callers present, so
@@ -301,13 +303,35 @@ export function xdevEntries(state: XdevState): Array<{ name: string; summary: st
 			name: tool.name,
 			summary: promptCatalogSummary(tool, dynamic ? XDEV_EXTERNAL_DESCRIPTION_CAP : undefined),
 			dynamic,
+			server: mcpServerOf(tool),
 		};
 	});
 }
 
-/** `read xd://` listing with one device per line. */
+function mcpServerOf(tool: Tool): string | undefined {
+	const server = (tool as { mcpServerName?: unknown }).mcpServerName;
+	return typeof server === "string" ? server : undefined;
+}
+
+/**
+ * Compact catalog lines: a device outside MCP keeps its one-line summary, and MCP
+ * devices list by name only, one line per server, since their summaries already
+ * sit in the system prompt and `read xd://<tool>` gives the full docs.
+ */
+export function xdevCatalogLines(entries: ReadonlyArray<{ name: string; summary: string; server?: string }>): string[] {
+	const lines: string[] = [];
+	const servers = new Map<string, string[]>();
+	for (const { name, summary, server } of entries) {
+		if (server === undefined) lines.push(`- ${XD_URL_PREFIX}${name} — ${summary}`);
+		else servers.set(server, [...(servers.get(server) ?? []), name]);
+	}
+	for (const [server, names] of servers) lines.push(`- ${server} (MCP): ${names.join(", ")}`);
+	return lines;
+}
+
+/** `read xd://` listing: built-in devices with summaries, MCP devices by name per server. */
 export function xdevListing(state: XdevState): string {
-	const rows = xdevEntries(state).map(({ name, summary }) => `${XD_URL_PREFIX}${name.padEnd(14)} ${summary}`);
+	const rows = xdevCatalogLines(xdevEntries(state));
 	return [
 		`${XD_URL_PREFIX} ${state.mountedNames.size} mounted tool devices.`,
 		...rows,
@@ -423,7 +447,7 @@ function resolveRequiredXdevTool(state: XdevState, name: string): Tool {
 	const inst = resolveXdevTool(state, name);
 	if (!inst) {
 		throw new ToolError(
-			`No such tool: ${XD_URL_PREFIX}${name}. Mounted devices: ${[...state.mountedNames].join(", ")}. Active top-level tools are also dispatchable via ${XD_URL_PREFIX}<tool>.`,
+			`No such tool: ${XD_URL_PREFIX}${sanitizeCatalogSummary(name, 100)}. Read ${XD_URL_PREFIX} for available devices; read ${XD_URL_PREFIX}<tool> for docs.`,
 		);
 	}
 	return inst;
