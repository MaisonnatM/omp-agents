{
  "name": "omp-agents",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/server.ts",
    "desktop": "bun install --cwd desktop --frozen-lockfile && bun run --cwd desktop start",
    "lint": "biome lint && bun scripts/lint/run.ts",
    "metrics": "bun scripts/harness-metrics.ts",
    "omp-release": "bun scripts/omp-release.ts",
    "omp-template": "bun templates/omp/install.ts",
    "prepare": "git config core.hooksPath .githooks",
    "test": "bun test",
    "test:agent": "bun scripts/agent-test.ts",
    "typecheck": "(test -d node_modules || bun install --frozen-lockfile) && tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/bun": "^1.4.2",
    "@types/hast": "^3.0.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun": "1.4.4",
    "bun-plugin-tailwind": "^0.1.2",
    "pixelmatch": "^8.0.0",
    "playwright-core": "1.64.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lexical/code-core": "0.52.0",
