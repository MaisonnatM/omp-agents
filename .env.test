# `bun test` loads this before any test, so every child inherits it, even through Bun's default spawn environment, which a preload cannot change.
# Git ignores the developer's global and system config: no signing through their shared gpg-agent, which stalls under concurrent signing, no LFS filters, no detached auto-maintenance.
GIT_CONFIG_GLOBAL=/dev/null
GIT_CONFIG_NOSYSTEM=1
GIT_CONFIG_COUNT=3
GIT_CONFIG_KEY_0=user.name
GIT_CONFIG_VALUE_0="omp-agents tests"
GIT_CONFIG_KEY_1=user.email
GIT_CONFIG_VALUE_1=tests@omp-agents.invalid
GIT_CONFIG_KEY_2=maintenance.auto
GIT_CONFIG_VALUE_2=false
