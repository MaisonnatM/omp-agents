#!/bin/sh
# Runs the checks .github/workflows/checks.yml runs, so a push to main cannot land before CI.
# Installed by the `prepare` script; skip once with `git push --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"
is_zero() { case $1 in *[!0]*) return 1 ;; esac; }
# Git sends the pushed refs on stdin; read them before bun, which could consume it.
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$remote_ref" = refs/heads/main ] || continue
	if is_zero "$local_sha" || is_zero "$remote_sha"; then continue; fi
	status=0
	git diff --quiet "$remote_sha" "$local_sha" -- CHANGELOG.md || status=$?
	if [ "$status" -eq 0 ]; then
		echo "Pushing to main needs new lines in CHANGELOG.md that say, in everyday words, what changed. See CODING_STANDARDS.md#changelog." >&2
		exit 1
	fi
	[ "$status" -eq 1 ] || exit "$status"
done
# Git exports GIT_DIR and friends to hooks; tests that create their own repositories must not inherit them.
unset $(git rev-parse --local-env-vars)
bun install --frozen-lockfile
bun test
bun run typecheck
bun install --cwd desktop --frozen-lockfile
bun run --cwd desktop typecheck
