#!/bin/sh
# Runs the checks .github/workflows/checks.yml runs, so a push to main cannot land before CI.
# Installed by the `prepare` script; skip once with `git push --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"
# Git exports GIT_DIR and friends to hooks; tests that create their own repositories must not inherit them.
unset $(git rev-parse --local-env-vars)
bun install --frozen-lockfile
bun test
bun run typecheck
bun install --cwd desktop --frozen-lockfile
bun run --cwd desktop typecheck
